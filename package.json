{
  "name": "notepadweb",
  "private": true,
  "version": "1.7.3",
  "description": "NotePadWeb-- desktop shell",
  "main": "electron/main.js",
  "scripts": {
    "setup": "neu update",
    "desktop": "node tools/remote_config.js && neu update && node tools/stage_frontend.js && node tools/gen_icon.js && neu run",
    "build": "node tools/remote_config.js && neu update && node tools/stage_frontend.js && node tools/gen_icon.js && neu build --release && node tools/pack_desktop.js && node tools/clean.js",
    "electron": "electron .",
    "electron:appimage": "node tools/remote_config.js && electron-builder --linux AppImage",
    "electron:dir": "node tools/remote_config.js && electron-builder --linux dir",
    "chrome": "node tools/pack_chrome.js",
    "chrome:remote": "node tools/remote_config.js",
    "chrome:upload": "node tools/upload_chrome.js",
    "clean": "node tools/clean.js"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.8.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "uuid": "^8.3.2"
  },
  "build": {
    "appId": "dev.notepadweb.desktop",
    "productName": "NotePadWeb",
    "copyright": "MIT",
    "directories": {
      "output": "../NotePadWeb-release/electron"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "ext/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility;TextEditor",
      "artifactName": "NotePadWeb-${version}-linux-x86_64.AppImage"
    },
    "appImage": {
      "artifactName": "NotePadWeb-${version}-linux-x86_64.AppImage"
    }
  }
}
