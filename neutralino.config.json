{
  "applicationId": "dev.notepadweb.desktop",
  "version": "0.1.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "events.*"
  ],
  "modes": {
    "window": {
      "title": "NotePadWeb--",
      "width": 1100,
      "height": 760,
      "minWidth": 720,
      "minHeight": 480,
      "icon": "/resources/icons/128x128.png",
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "NotePadWeb",
    "distributionPath": "../NotePadWeb-release/.build",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/js/neutralino.js",
    "resourcesExclude": "(^|[\\\\/])(node_modules|bin|dist|\\.git|\\.storage)([\\\\/]|$)",
    "binaryVersion": "6.2.0",
    "clientVersion": "6.2.0"
  }
}
